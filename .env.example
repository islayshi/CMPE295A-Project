# ==============================================================
# Fight Fire With AI — Environment Variables
# ==============================================================
# Copy this file to `.env` in the project root and fill in
# your local values. NEVER commit `.env` to git.
#
# For local Docker dev:   values below are ready-to-use defaults
# For GCP production:     override via Cloud Run environment vars
# ==============================================================

# --------------------------------------------------------------
# Django Core
# --------------------------------------------------------------
# Generate a new secret key with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me-before-using-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --------------------------------------------------------------
# PostgreSQL / PostGIS  (maps to docker-compose `db` service)
# --------------------------------------------------------------
DB_NAME=ffwai_db
DB_USER=ffwai_user
DB_PASSWORD=ffwai_password
DB_HOST=localhost
DB_PORT=5432

# --------------------------------------------------------------
# Redis  (maps to docker-compose `redis` service)
# Celery broker URL + Django cache backend
# --------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379

# --------------------------------------------------------------
# Celery
# --------------------------------------------------------------
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --------------------------------------------------------------
# ML Inference
# --------------------------------------------------------------
# Set to True during Month 1 development — returns mock GeoJSON
# Set to False in Month 2 when Vertex AI endpoints are live
MOCK_INFERENCE=True

# FastAPI ML Adapter URL (local dev: run FastAPI separately)
ML_ADAPTER_URL=http://localhost:8001

# GCP Vertex AI Endpoint IDs (filled in by ML team in Month 2)
VERTEX_AI_PROJECT_ID=
VERTEX_AI_LOCATION=us-central1
VERTEX_UNET_ENDPOINT_ID=
VERTEX_PINN_ENDPOINT_ID=
VERTEX_RL_ENDPOINT_ID=

# --------------------------------------------------------------
# Google Earth Engine
# --------------------------------------------------------------
# Path to your GEE service account JSON key file
GEE_SERVICE_ACCOUNT_KEY_PATH=

# --------------------------------------------------------------
# Google Cloud Storage
# --------------------------------------------------------------
GCS_BUCKET_NAME=fightfirewai-features
GCS_FEATURES_PREFIX=daily

# --------------------------------------------------------------
# External APIs
# --------------------------------------------------------------
OPENWEATHER_API_KEY=
NWS_API_USER_AGENT=FightFireWithAI/1.0 (your-email@example.com)
