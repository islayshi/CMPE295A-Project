# ==============================================================================
# Fight Fire With AI — Environment Variables Template
# ==============================================================================
# Copy this file to `.env` in the project root:
#   cp .env.example .env
#
# For local Docker dev:   ready-to-use defaults below
# For GCP production:     managed via Secret Manager and Cloud Run env vars
# ==============================================================================

# ------------------------------------------------------------------------------
# Django Core
# ------------------------------------------------------------------------------
SECRET_KEY=replace-with-a-secure-secret-key-for-local-development
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# ------------------------------------------------------------------------------
# PostgreSQL / PostGIS (maps to docker-compose `db` service)
# ------------------------------------------------------------------------------
DB_NAME=ffwai_db
DB_USER=ffwai_user
DB_PASSWORD=ffwai_password
DB_HOST=localhost
DB_PORT=5432

# ------------------------------------------------------------------------------
# Redis (maps to docker-compose `redis` service)
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ------------------------------------------------------------------------------
# ML Inference & Microservices Bridge
# ------------------------------------------------------------------------------
MOCK_INFERENCE=False
ML_ADAPTER_URL=http://localhost:8001
UNET_SERVICE_URL=http://localhost:8081
PINN_SERVICE_URL=http://localhost:8082

# ------------------------------------------------------------------------------
# Google Cloud Platform & Earth Engine
# ------------------------------------------------------------------------------
GCP_PROJECT_ID=your-gcp-project-id
GEE_PROJECT_ID=your-gcp-project-id
GCS_BUCKET_NAME=fightfirewai-features

# ------------------------------------------------------------------------------
# External Active Fire APIs
# ------------------------------------------------------------------------------
# NASA FIRMS API Map Key for satellite active fire detections
FIRMS_MAP_KEY=your-nasa-firms-map-key

